# SDL2 BUILD RECIPE.

[windows:default]
if not exist build mkdir build
cmake -S . -B build -G "Visual Studio 18 2026"
cmake --build build --config Release
%out = build/src/Release/sdl2.lib

[linux:default]
mkdir -p build
cmake -S . -B build -G "Ninja"
cmake --build build --config Release
%out = build/src/libsdl2.a

[macos:default = macos:ninja]

[macos:xcode]
mkdir -p build
cmake -S . -B build -G "Xcode"
cmake --build build --config Release
%out = build/src/libsdl2.a

[macos:ninja]
mkdir -p build
cmake -S . -B build -G "Ninja"
cmake --build build --config Release
%out = build/src/libsdl2.a
